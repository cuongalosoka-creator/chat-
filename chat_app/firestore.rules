rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedMember() {
      return exists(/databases/$(database)/documents/rooms/private_room/members/$(request.auth.uid));
    }

    // Chặn đọc/ghi trực tiếp document chứa mã phòng (roomCodeHash)
    match /rooms/private_room {
      allow read, write: if false;

      // Danh sách thành viên: chỉ vào được khi roomCodeHash gửi lên khớp với roomCodeHash trên server
      match /members/{userId} {
        allow read: if isSignedIn() && isVerifiedMember();
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['name', 'platform', 'roomCodeHash', 'lastSeen'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 28
          && request.resource.data.platform is string
          && request.resource.data.roomCodeHash is string
          && request.resource.data.roomCodeHash == get(/databases/$(database)/documents/rooms/private_room).data.roomCodeHash;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Tin nhắn: chỉ thành viên đã xác thực mã phòng mới được đọc và gửi tin
      match /messages/{messageId} {
        allow read: if isSignedIn() && isVerifiedMember();
        allow create: if isSignedIn()
          && isVerifiedMember()
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'senderPlatform', 'text', 'timestamp'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 2
          && request.resource.data.senderName.size() <= 28
          && request.resource.data.senderPlatform is string
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1500;
        allow update, delete: if false;
      }
    }
  }
}
